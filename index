<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tachyon | House Points</title>
<style>
  :root {
    --bg: #0b1020; --panel: #131a2e; --panel2: #18223a; --text: #f4f7ff;
    --muted: #a5b0ca; --line: rgba(255,255,255,.1); --accent: #a78bfa;
    --alpha: #60a5fa; --infer: #fb923c; --matrix: #4ade80; --layer: #f472b6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(ellipse at 15% 0%, rgba(124,58,237,.22), transparent 38%),
      radial-gradient(ellipse at 100% 15%, rgba(59,130,246,.14), transparent 32%), var(--bg);
  }
  .wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 34px 0 48px; }
  header { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:32px; }
  .brand { display:flex; align-items:center; gap:13px; }
  .logo { display:grid; place-items:center; width:48px; height:48px; border-radius:15px; background:linear-gradient(135deg,#8b5cf6,#3b82f6); font-size:24px; font-weight:900; box-shadow:0 10px 30px #6d28d944; }
  .eyebrow { color:#b8a7ff; font-size:11px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; }
  h1 { margin:3px 0 0; font-size:clamp(24px,4vw,34px); letter-spacing:-.04em; }
  .live { border:1px solid var(--line); color:#cbd5e1; border-radius:999px; padding:9px 13px; font-size:12px; display:flex; align-items:center; gap:8px; white-space:nowrap; }
  .dot { width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 12px #4ade8088; }
  .intro { margin-bottom:22px; }
  .intro h2 { margin:0 0 7px; font-size:clamp(20px,3vw,27px); letter-spacing:-.03em; }
  .intro p { color:var(--muted); margin:0; line-height:1.6; }
  .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:24px 0 28px; }
  .stat, .panel, .house-card { background:rgba(19,26,46,.88); border:1px solid var(--line); border-radius:20px; box-shadow:0 12px 40px rgba(0,0,0,.12); }
  .stat { padding:18px 20px; }
  .stat-label { color:var(--muted); font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
  .stat-value { font-size:30px; font-weight:800; margin-top:8px; letter-spacing:-.04em; }
  .stat-sub { color:#8e9bb8; font-size:12px; margin-top:3px; }
  .section-title { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:0 0 14px; }
  .section-title h3 { font-size:17px; margin:0; letter-spacing:-.02em; }
  .section-title span { color:var(--muted); font-size:12px; }
  .houses { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:28px; }
  .house-card { position:relative; padding:18px; overflow:hidden; }
  .house-card::before { content:"";position:absolute;inset:0 0 auto;height:3px;background:var(--house); }
  .house-top { display:flex;align-items:center;justify-content:space-between; gap:8px; }
  .house-name { font-size:13px;font-weight:800;letter-spacing:.12em; }
  .house-symbol { width:34px;height:34px;border-radius:11px;background:color-mix(in srgb,var(--house) 16%,transparent);color:var(--house);display:grid;place-items:center;font-weight:900; }
  .house-score { font-size:clamp(27px,3vw,36px);font-weight:850;letter-spacing:-.05em;margin:22px 0 3px; }
  .house-caption { color:var(--muted);font-size:12px; }
  .house-rank { margin-top:16px;display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:8px;background:rgba(255,255,255,.055);color:#cbd5e1;font-size:11px;font-weight:700; }
  .main-grid { display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:16px;align-items:start; }
  .panel { padding:22px; }
  .panel h3 { margin:0;font-size:17px;letter-spacing:-.02em; }
  .panel-desc { color:var(--muted);font-size:13px;line-height:1.5;margin:7px 0 20px; }
  label { display:block;font-size:12px;font-weight:750;color:#d6def0;margin:0 0 8px; }
  select, input { width:100%;border:1px solid rgba(255,255,255,.13);background:#0e1528;color:var(--text);padding:13px 14px;border-radius:12px;font:inherit;outline:none; }
  select:focus,input:focus { border-color:#a78bfa;box-shadow:0 0 0 3px rgba(167,139,250,.14); }
  .field { margin-bottom:17px; }
  .helper { color:#7f8ca8;font-size:11px;margin-top:7px; }
  button { cursor:pointer;border:0;font:inherit;font-weight:800;border-radius:12px;padding:13px 16px;transition:transform .15s,filter .15s; }
  button:hover { filter:brightness(1.08); } button:active { transform:scale(.98); }
  .primary { width:100%;color:#fff;background:linear-gradient(135deg,#8b5cf6,#6366f1);box-shadow:0 8px 22px #6366f133; }
  .secondary { background:rgba(255,255,255,.07);border:1px solid var(--line);color:#e2e8f0;padding:9px 12px;font-size:12px; }
  .danger { color:#fda4af; }
  .notice { display:none;margin-top:13px;border-radius:10px;padding:11px 12px;font-size:12px;line-height:1.45; }
  .notice.show { display:block; } .notice.ok { background:#14532d55;color:#bbf7d0;border:1px solid #22c55e44; } .notice.error { background:#7f1d1d55;color:#fecaca;border:1px solid #ef444444; }
  .leaderboard { margin-top:18px; }
  .rank-row { display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line); }
  .rank-row:last-child { border-bottom:0; }
  .rank-number { display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:rgba(255,255,255,.06);font-size:12px;font-weight:850;color:#cbd5e1; }
  .rank-row.first .rank-number { background:#fbbf2422;color:#fcd34d; }
  .rank-house { font-size:13px;font-weight:850;letter-spacing:.04em; }
  .rank-sub { color:var(--muted);font-size:11px;margin-top:3px; }
  .rank-points { font-weight:850;font-variant-numeric:tabular-nums; }
  .history-panel { margin-top:16px; }
  .history-head { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:13px; }
  .history-list { display:flex;flex-direction:column;gap:9px; }
  .history-item { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;border-radius:12px;background:rgba(255,255,255,.035); }
  .history-left { display:flex;align-items:center;gap:10px;min-width:0; }
  .history-mark { width:9px;height:34px;border-radius:999px;background:var(--house);flex-shrink:0; }
  .history-name { font-size:12px;font-weight:800; }
  .history-meta { color:var(--muted);font-size:11px;margin-top:3px; }
  .history-points { font-size:13px;font-weight:850;color:#86efac;white-space:nowrap; }
  .empty { padding:24px 12px;text-align:center;color:var(--muted);font-size:13px;line-height:1.6;border:1px dashed var(--line);border-radius:12px; }
  footer { margin-top:26px;text-align:center;color:#65728f;font-size:11px; }
  @media (max-width:850px) { .houses{grid-template-columns:repeat(2,1fr)} .main-grid{grid-template-columns:1fr} }
  @media (max-width:560px) { .wrap{width:calc(100% - 22px);padding-top:22px} header{align-items:flex-start;margin-bottom:26px}.live{font-size:0;padding:11px}.live .dot{width:8px;height:8px}.stats{gap:8px}.stat{padding:13px 11px;border-radius:15px}.stat-value{font-size:23px}.stat-label{font-size:10px}.stat-sub{font-size:10px}.houses{gap:9px}.house-card{padding:14px;border-radius:16px}.panel{padding:17px}.section-title span{display:none} }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="logo">T</div>
      <div><div class="eyebrow">Tachyon • Inter-house scoreboard</div><h1>House Points</h1></div>
    </div>
    <div class="live"><span class="dot"></span> LIVE SCOREBOARD</div>
  </header>

  <section class="intro">
    <h2>Every point counts.</h2>
    <p>Record house points, track the leaderboard, and see who's leading the Tachyon challenge.</p>
  </section>

  <section class="stats" aria-label="Score summary">
    <div class="stat"><div class="stat-label">Total points awarded</div><div class="stat-value" id="totalPoints">0</div><div class="stat-sub">Across all four houses</div></div>
    <div class="stat"><div class="stat-label">Leading house</div><div class="stat-value" id="leadingHouse" style="font-size:25px">—</div><div class="stat-sub" id="leadSubtitle">The competition starts here</div></div>
    <div class="stat"><div class="stat-label">Score entries</div><div class="stat-value" id="entryCount">0</div><div class="stat-sub">Points transactions recorded</div></div>
  </section>

  <div class="section-title"><h3>House scoreboard</h3><span>Automatically updated after every entry</span></div>
  <section class="houses" id="houseCards" aria-label="House scores"></section>

  <div class="main-grid">
    <section class="panel">
      <h3>Add points</h3>
      <p class="panel-desc">Choose a house and enter the points it earned. The points will be added to its current total.</p>
      <form id="scoreForm">
        <div class="field">
          <label for="houseSelect">HOUSE</label>
          <select id="houseSelect" required>
            <option value="ALPHA">ALPHA</option><option value="INFER">INFER</option><option value="MATRIX">MATRIX</option><option value="LAYER">LAYER</option>
          </select>
        </div>
        <div class="field">
          <label for="pointsInput">POINTS EARNED</label>
          <input id="pointsInput" type="number" min="1" step="1" placeholder="e.g. 25" required inputmode="numeric">
          <div class="helper">Enter a whole number greater than zero.</div>
        </div>
        <button class="primary" type="submit">＋ &nbsp; Award points</button>
        <div class="notice" id="notice" role="status" aria-live="polite"></div>
      </form>
      <div style="height:1px;background:var(--line);margin:22px 0"></div>
      <div class="section-title"><h3>Leaderboard</h3><span>Highest score first</span></div>
      <div class="leaderboard" id="leaderboard"></div>
    </section>

    <section class="panel">
      <div class="history-head"><div><h3>Points history</h3><p class="panel-desc" style="margin:6px 0 0">A record of every points award.</p></div><button class="secondary" id="clearHistoryBtn" type="button">Clear history</button></div>
      <div class="history-list" id="historyList"></div>
      <div style="border-top:1px solid var(--line);margin-top:20px;padding-top:17px;display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div><div style="font-size:12px;font-weight:800">Reset scoreboard</div><div style="color:var(--muted);font-size:11px;margin-top:4px">Set every house back to zero.</div></div>
        <button class="secondary danger" id="resetBtn" type="button">Reset all</button>
      </div>
    </section>
  </div>
  <footer> TACHYON HOUSE POINTS CALCULATOR · Scores are saved in this browser on this device.</footer>
</div>
<script>
(() => {
  const HOUSES = {
    ALPHA: { color: 'var(--alpha)', symbol: 'A' },
    INFER: { color: 'var(--infer)', symbol: 'I' },
    MATRIX: { color: 'var(--matrix)', symbol: 'M' },
    LAYER: { color: 'var(--layer)', symbol: 'L' }
  };
  const STORAGE_KEY = 'tachyon-house-points-v1';
  const freshState = () => ({
    scores: { ALPHA: 0, INFER: 0, MATRIX: 0, LAYER: 0 },
    history: []
  });
  let state = loadState();

  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
      if (saved && saved.scores && saved.history && Object.keys(HOUSES).every(h => Number.isFinite(saved.scores[h]) && saved.scores[h] >= 0)) {
        return { scores: saved.scores, history: saved.history.filter(item => item && HOUSES[item.house] && Number.isFinite(item.points) && item.points > 0) };
      }
    } catch (_) { /* Use a clean scoreboard if saved data is unavailable. */ }
    return freshState();
  }
  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    catch (_) { showNotice('Your browser could not save the scores. They may not remain after refreshing.', 'error'); }
  }
  const fmt = n => n.toLocaleString('en-IN');
  function getRanking() {
    return Object.keys(HOUSES).sort((a,b) => state.scores[b] - state.scores[a] || a.localeCompare(b));
  }
  function leaders() {
    const max = Math.max(...Object.values(state.scores));
    return Object.keys(HOUSES).filter(h => state.scores[h] === max);
  }
  function renderCards() {
    document.getElementById('houseCards').innerHTML = Object.keys(HOUSES).map(h => `
      <article class="house-card" style="--house:${HOUSES[h].color}">
        <div class="house-top"><div class="house-name">${h}</div><div class="house-symbol">${HOUSES[h].symbol}</div></div>
        <div class="house-score">${fmt(state.scores[h])}</div>
        <div class="house-caption">total points</div>
        <div class="house-rank">${getRanking().indexOf(h) === 0 && state.scores[h] > 0 ? '★ Leading' : '↗ Rank ' + (getRanking().indexOf(h) + 1)}</div>
      </article>`).join('');
  }
  function renderSummary() {
    const total = Object.values(state.scores).reduce((sum,n) => sum+n, 0);
    const lead = leaders();
    document.getElementById('totalPoints').textContent = fmt(total);
    document.getElementById('entryCount').textContent = fmt(state.history.length);
    document.getElementById('leadingHouse').textContent = total === 0 ? '—' : lead.length > 1 ? 'TIE' : lead[0];
    document.getElementById('leadSubtitle').textContent = total === 0 ? 'The competition starts here' : lead.length > 1 ? 'Multiple houses share the lead' : `${fmt(state.scores[lead[0]])} points so far`;
  }
  function renderLeaderboard() {
    const order = getRanking();
    const tiedLeaders = leaders();
    document.getElementById('leaderboard').innerHTML = order.map((h,i) => {
      const isFirst = state.scores[h] > 0 && tiedLeaders.includes(h);
      const place = isFirst ? (tiedLeaders.length > 1 ? 'Tied for first' : 'Current leader') : 'Rank ' + (i+1);
      return `<div class="rank-row ${isFirst?'first':''}">
        <div class="rank-number">${isFirst?'★':i+1}</div>
        <div><div class="rank-house" style="color:${HOUSES[h].color}">${h}</div><div class="rank-sub">${place}</div></div>
        <div class="rank-points">${fmt(state.scores[h])} pts</div>
      </div>`;
    }).join('');
  }
  function renderHistory() {
    const list = document.getElementById('historyList');
    if (!state.history.length) {
      list.innerHTML = '<div class="empty">No points recorded yet.<br>When points are awarded, each entry will appear here.</div>';
      return;
    }
    list.innerHTML = state.history.slice().reverse().map(item => `
      <div class="history-item">
        <div class="history-left"><div class="history-mark" style="--house:${HOUSES[item.house].color}"></div>
          <div><div class="history-name">${item.house}</div><div class="history-meta">${escapeHtml(item.time)} · Total after award: ${fmt(item.totalAfter)}</div></div>
        </div><div class="history-points">+${fmt(item.points)} pts</div>
      </div>`).join('');
  }
  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function render() { renderCards(); renderSummary(); renderLeaderboard(); renderHistory(); }
  function showNotice(message, type) {
    const box = document.getElementById('notice');
    box.textContent = message; box.className = `notice show ${type}`;
  }
  document.getElementById('scoreForm').addEventListener('submit', event => {
    event.preventDefault();
    const house = document.getElementById('houseSelect').value;
    const raw = document.getElementById('pointsInput').value;
    const points = Number(raw);
    if (!HOUSES[house]) { showNotice('Please select a valid house.', 'error'); return; }
    if (!raw.trim() || !Number.isSafeInteger(points) || points <= 0) {
      showNotice('Enter a whole number of points greater than zero.', 'error'); return;
    }
    if (!Number.isSafeInteger(state.scores[house] + points)) {
      showNotice('That score is too large. Please enter a smaller number.', 'error'); return;
    }
    state.scores[house] += points;
    state.history.push({
      house, points, totalAfter: state.scores[house],
      time: new Date().toLocaleString([], {dateStyle:'medium', timeStyle:'short'})
    });
    saveState(); render();
    showNotice(`${house} awarded ${fmt(points)} points. New total: ${fmt(state.scores[house])}.`, 'ok');
    document.getElementById('pointsInput').value = '';
    document.getElementById('pointsInput').focus();
  });
  document.getElementById('resetBtn').addEventListener('click', () => {
    if (!confirm('Reset all four house scores and delete the complete points history? This cannot be undone.')) return;
    state = freshState(); saveState(); render();
    showNotice('Scoreboard reset. All house totals are now zero.', 'ok');
  });
  document.getElementById('clearHistoryBtn').addEventListener('click', () => {
    if (!state.history.length) { showNotice('There is no history to clear.', 'error'); return; }
    if (!confirm('Clear the points history? House totals will remain unchanged.')) return;
    state.history = []; saveState(); render();
    showNotice('Points history cleared. House totals have been kept.', 'ok');
  });
  render();
})();
</script>
</body>
</html>
